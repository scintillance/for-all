---
const { frontmatter } = Astro.props;

if (globalThis.__problemCounterMap) globalThis.__problemCounterMap.problemCount = 0;

import "/global-styles.css"; 
import Header from '../components/layout-comps/Header.astro';
import Footer from '../components/layout-comps/Footer.astro';
import { Image } from 'astro:assets';
import Layout from "../layouts/Layout.astro";

const images = import.meta.glob<{ default: ImageMetadata }>('../images/**/*.{jpeg,jpg,png,gif}')
const imagePath = frontmatter.featuredimage;

if (!images[imagePath]) {
  throw new Error(`"${imagePath}" does not exist in "../images/"`);
}
---

<Layout title={frontmatter.title}>
  
  <Header />
  <Image src={images[imagePath]()} alt="" aria-hidden="true" style="width: 100%; height: 430px; object-fit: cover; display: block; margin: 0 auto var(--wp-spacing-30) auto;" />

  <main class="post" id="resultsBox">
    
    <header>
      <h1>{frontmatter.title}</h1>
      <!-- <p>Published on: {frontmatter.date}</p> -->
    </header>

    <div class="content-wrapper">
      <div class="content">
        <div class="whole-screen"></div>
        <!-- Markdown/MDX text content is injected here -->
        <slot />
      </div>
    </div>

  </main>
  
  <Footer />
</Layout>