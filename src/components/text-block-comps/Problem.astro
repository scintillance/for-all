---
// Problem

if (!globalThis.__problemCounterMap) {
    globalThis.__problemCounterMap = { problemCount: 0 };
}
globalThis.__problemCounterMap.problemCount++;
const currentProblemCount = globalThis.__problemCounterMap.problemCount;


import "/global-styles.css"; 
---

<div class="spacing-as-p">
    <span class="problem-number spacing-as-nothing">{currentProblemCount}</span>
    <div class="problem">
        <slot />
    </div>
</div>