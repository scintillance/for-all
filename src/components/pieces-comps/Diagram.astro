---
import "/global-styles.css"; 
const { w, h } = Astro.props;
---

<div class="diagram spacing-bigger">
    <div class="grid" style="box-shadow: var(--glow-inset-shadow); border-radius: 50px; border: 0px solid #fff;">
        <svg width={w} height={h} viewBox=`0 0 ${w} ${h}` style="background: transparent; display: block;">
            <slot/>        
        </svg>
    </div>
    <div class="figure">
        <slot name="fig"/>
    </div>
</div>
    