---
import "/global-styles.css"; 
const { w, h } = Astro.props;
---

<figure class="diagram padded spacing-bigger">
    <div class="grid inset-window">
        <svg viewBox=`0 0 ${w} ${h}` width="auto%" height="auto%" preserveAspectRatio="xMidYMid meet"  xmlns="http://www.w3.org/2000/svg" style="background: transparent; display: block;">
            <slot/>
        </svg>
    </div>
    <figcaption class="figcaption">
        <slot name="fig"/>
    </figcaption>
</figure>
    