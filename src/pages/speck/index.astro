---
import Layout from "../../layouts/Layout.astro";
import HomeHeader from "../../components/layout-comps/Home-Header.astro";
---

<Layout title="Scintilla Specks">

	<HomeHeader/>
	
	<div class="speck">
		<div class="title-wrapper">
			<div class="page-title">
				specks
			</div>
		</div>
		<div class="container">
			
			<p><span class="Specks">Specks</span> are what I call this forever-updating glossary of <span class="orange">math terms</span>, <span class="orange">theorems</span>, and <span class="orange">ideas</span>. </p>
                
            <p>Each small entry, or <i>"speck"</i>, includes a simple definition, but also some mathematical rigor and more challenging related topics. When I can, I also include examples, exercises, and further resources.</p>
			
            <p>Have fun browsing!</p>

		</div>
		<div class="specks">
		
		</div>
	</div>

</Layout>
